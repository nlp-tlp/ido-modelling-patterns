<https://nlp-tlp.org/ontology/pump/core> rdf:type owl:Ontology ;
                                          owl:versionIRI <https://nlp-tlp.org/ontology/pump/core/0.1> ;
                                          owl:imports <https://nlp-tlp.org/ontology/eqp/ont/core/0.1> ;
                                          <http://purl.org/dc/terms/title> "Pump Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://rds.posccaesar.org/ontology/lis14/rdl/datumUOM
lis:datumUOM rdf:type owl:AnnotationProperty .


###  http://rds.posccaesar.org/ontology/lis14/rdl/datumValue
lis:datumValue rdf:type owl:AnnotationProperty .


###  http://rds.posccaesar.org/ontology/lis14/rdl/hasAssembledPart
lis:hasAssembledPart rdf:type owl:AnnotationProperty .


###  http://rds.posccaesar.org/ontology/lis14/rdl/hasContentPart
lis:hasContentPart rdf:type owl:AnnotationProperty .


###  http://rds.posccaesar.org/ontology/lis14/rdl/hasMaterialPart
lis:hasMaterialPart rdf:type owl:AnnotationProperty .


###  http://rds.posccaesar.org/ontology/lis14/rdl/hasPart
lis:hasPart rdf:type owl:AnnotationProperty .


###  http://rds.posccaesar.org/ontology/lis14/rdl/isAbout
lis:isAbout rdf:type owl:AnnotationProperty .


###  http://rds.posccaesar.org/ontology/lis14/rdl/qualityQuantifiedAs
lis:qualityQuantifiedAs rdf:type owl:AnnotationProperty .


###  https://nlp-tlp.org/ontology/eqp/rdl/designationValue
eqp:designationValue rdf:type owl:AnnotationProperty .


###  https://nlp-tlp.org/ontology/eqp/rdl/hasDesignation
eqp:hasDesignation rdf:type owl:AnnotationProperty .


###  https://nlp-tlp.org/ontology/eqp/rdl/tokenOrder
eqp:tokenOrder rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  https://nlp-tlp.org/ontology/pump/rdl/CentrifugalPump
pump:CentrifugalPump rdf:type owl:Class ;
                     rdfs:subClassOf pump:Pump ;
                     rdfs:label "Centrifugal Pump" .


###  https://nlp-tlp.org/ontology/pump/rdl/Diameter
pump:Diameter rdf:type owl:Class ;
              rdfs:subClassOf lis:PhysicalQuantity ;
              rdfs:label "Diameter" .


###  https://nlp-tlp.org/ontology/pump/rdl/Impeller
pump:Impeller rdf:type owl:Class ;
              rdfs:subClassOf eqp:Component ;
              rdfs:label "Impeller" .


###  https://nlp-tlp.org/ontology/pump/rdl/Motor
pump:Motor rdf:type owl:Class ;
           rdfs:subClassOf eqp:Equipment ;
           rdfs:label "Motor" .


###  https://nlp-tlp.org/ontology/pump/rdl/Power
pump:Power rdf:type owl:Class ;
           rdfs:subClassOf lis:PhysicalQuantity ;
           rdfs:label "Power" .


###  https://nlp-tlp.org/ontology/pump/rdl/Pressure
pump:Pressure rdf:type owl:Class ;
              rdfs:subClassOf lis:PhysicalQuantity ;
              rdfs:label "Pressure" .


###  https://nlp-tlp.org/ontology/pump/rdl/Pump
pump:Pump rdf:type owl:Class ;
          rdfs:subClassOf eqp:Equipment ;
          rdfs:label "Pump" .


###  https://nlp-tlp.org/ontology/pump/rdl/SingleStagePump
pump:SingleStagePump rdf:type owl:Class ;
                     rdfs:subClassOf pump:CentrifugalPump ;
                     rdfs:label "Single-Stage, End-Suction Pump" .


###  https://nlp-tlp.org/ontology/pump/rdl/Speed
pump:Speed rdf:type owl:Class ;
           rdfs:subClassOf lis:PhysicalQuantity ;
           rdfs:label "Speed" .


###  https://nlp-tlp.org/ontology/pump/rdl/VolumetricFlowRate
pump:VolumetricFlowRate rdf:type owl:Class ;
                        rdfs:subClassOf lis:PhysicalQuantity ;
                        rdfs:label "Volumetric Flow Rate" .


###  https://nlp-tlp.org/ontology/pump/rdl/Volute
pump:Volute rdf:type owl:Class ;
            rdfs:subClassOf eqp:Component ;
            rdfs:label "Volute" .


#################################################################
#    Individuals
#################################################################

###  https://nlp-tlp.org/ontology/pump/rdl/P-101
pump:P-101 rdf:type owl:NamedIndividual ,
                    pump:SingleStagePump ;
           lis:hasAssembledPart pump:P-101_volute ;
           lis:hasPhysicalQuantity pump:P-101_rated_flow_rate ,
                                   pump:P-101_rated_head ,
                                   pump:P-101_speed ;
           eqp:hasDesignation pump:P-101_designation ;
           lis:hasAssembledPart pump:P-101_impeller ;
           lis:hasPart pump:P-101_impeller ;
           rdfs:label "P-101" .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_designation
pump:P-101_designation rdf:type owl:NamedIndividual ,
                                eqp:Designation ;
                       lis:hasContentPart pump:P-101_designation_token1 ,
                                          pump:P-101_designation_token2 ,
                                          pump:P-101_designation_token3 ,
                                          pump:P-101_designation_token4 ,
                                          pump:P-101_designation_token5 ;
                       eqp:designationValue "Grundfos NB 50-160/150" .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_designation_token1
pump:P-101_designation_token1 rdf:type owl:NamedIndividual ,
                                       eqp:DesignationToken ;
                              eqp:designationValue "Grundfos" ;
                              eqp:tokenOrder "1"^^xsd:positiveInteger .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_designation_token2
pump:P-101_designation_token2 rdf:type owl:NamedIndividual ,
                                       eqp:DesignationToken ;
                              eqp:designationValue "NB" ;
                              eqp:tokenOrder "2"^^xsd:positiveInteger .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_designation_token3
pump:P-101_designation_token3 rdf:type owl:NamedIndividual ,
                                       eqp:DesignationToken ;
                              eqp:designationValue "50" ;
                              eqp:tokenOrder "3"^^xsd:positiveInteger .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_designation_token4
pump:P-101_designation_token4 rdf:type owl:NamedIndividual ,
                                       eqp:DesignationToken ;
                              eqp:designationValue "160" ;
                              eqp:tokenOrder "4"^^xsd:positiveInteger .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_designation_token5
pump:P-101_designation_token5 rdf:type owl:NamedIndividual ,
                                       eqp:DesignationToken ;
                              lis:isAbout pump:P-101_impeller_diameter ;
                              eqp:designationValue "150" ;
                              eqp:tokenOrder "5"^^xsd:positiveInteger .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_impeller
pump:P-101_impeller rdf:type owl:NamedIndividual ,
                             pump:Impeller ;
                    lis:hasMaterialPart pump:stainless_steel ;
                    lis:hasPhysicalQuantity pump:P-101_impeller_diameter .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_impeller_diameter
pump:P-101_impeller_diameter rdf:type owl:NamedIndividual ,
                                      pump:Diameter ;
                             lis:qualityQuantifiedAs pump:dat_150_mm .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_motor
pump:P-101_motor rdf:type owl:NamedIndividual ,
                          pump:Motor ;
                 lis:connectedTo pump:P-101 ;
                 lis:hasPhysicalQuantity pump:P-101_motor_power .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_motor_power
pump:P-101_motor_power rdf:type owl:NamedIndividual ,
                                pump:Power ;
                       lis:qualityQuantifiedAs pump:dat_7_5_kw .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_rated_flow_rate
pump:P-101_rated_flow_rate rdf:type owl:NamedIndividual ,
                                    pump:VolumetricFlowRate ;
                           lis:qualityQuantifiedAs pump:dat_50_m3ph .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_rated_head
pump:P-101_rated_head rdf:type owl:NamedIndividual ,
                               pump:Pressure ;
                      lis:qualityQuantifiedAs pump:dat_3_bar .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_speed
pump:P-101_speed rdf:type owl:NamedIndividual ,
                          pump:Speed ;
                 lis:qualityQuantifiedAs pump:dat_2900_rpm .


###  https://nlp-tlp.org/ontology/pump/rdl/P-101_volute
pump:P-101_volute rdf:type owl:NamedIndividual ,
                           pump:Volute ;
                  lis:hasMaterialPart pump:cast_iron .


